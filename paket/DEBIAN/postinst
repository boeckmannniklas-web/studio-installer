#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  mkdir -p /opt/studio
  chmod 755 /opt/studio
  install -d -m 700 /var/lib/studio-installer
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
  # Icon für jeden Benutzer bei seiner nächsten Anmeldung (auch im chroot des Image-Installers)
  systemctl --global enable studio-schreibtisch.service >/dev/null 2>&1 || true
  # Nach der Anmeldung Studio im Kioskmodus öffnen (die Unit prüft selbst auf das Studio-Image)
  systemctl --global enable studio-kiosk.service >/dev/null 2>&1 || true
  command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    # Bereits eingerichtet: der Assistent bleibt aus, bis ihn jemand mit studio-einrichtung holt.
    if [ ! -f /opt/studio/installiert.json ]; then
      systemctl enable studio-setup.service || true
      # restart statt start: nach einem Update soll der neue Code laufen
      systemctl restart studio-setup.service || true
    else
      systemctl try-restart studio-setup.service || true
      # Eingerichtete Studios: Austauschordner nachrüsten, Sicherung und Updates einschalten.
      /usr/bin/studio-betrieb nachruesten || true
      systemctl enable --now studio-sicherung.timer studio-update.timer studio-auftrag.path || true
    fi
  else
    # Im Installer des Studio-Images (chroot): nur einschalten, gestartet wird beim ersten Boot.
    systemctl enable studio-setup.service >/dev/null 2>&1 || true
  fi
fi
exit 0
