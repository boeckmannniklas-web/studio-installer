#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
  systemctl --global disable studio-schreibtisch.service studio-kiosk.service >/dev/null 2>&1 || true
fi
if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
  systemctl disable --now studio-setup.service studio-sicherung.timer studio-update.timer studio-auftrag.path || true
fi
exit 0
