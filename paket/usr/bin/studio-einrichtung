#!/bin/sh
# Einrichtungs-Assistent erneut öffnen, auch wenn Studio schon installiert ist
# (z. B. Fernwartung, Backup-Ziel oder Updates nachträglich ändern). Braucht ein
# Administrator-Konto. Öffnet im Kioskmodus wie das Studio-Icon.
. /usr/lib/studio-installer/kiosk.sh

pkexec /bin/systemctl start studio-setup.service || exit 1
i=0
while [ ! -r /run/studio-setup/token ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
kiosk_oeffnen "http://127.0.0.1:8099/?t=$(cat /run/studio-setup/token)"
