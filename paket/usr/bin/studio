#!/bin/sh
# Studio-Icon: nach der Einrichtung die Kasse öffnen, vorher den Einrichtungs-Assistenten –
# beides im Kioskmodus (Vollbild ohne Adressleiste, siehe kiosk.sh).
. /usr/lib/studio-installer/kiosk.sh

if [ -f /opt/studio/installiert.json ]; then
  # Nach dem Hochfahren braucht Studio etwas. Im Kiosk gibt es keinen Neu-laden-Knopf –
  # also erst öffnen, wenn es antwortet, statt eine Fehlerseite stehen zu lassen.
  i=0
  until curl -fs -o /dev/null --max-time 3 http://localhost/api/v1/health; do
    [ $i -eq 2 ] && meldung "Studio startet … einen Moment bitte."
    i=$((i + 1))
    if [ $i -gt 90 ]; then
      meldung "Studio antwortet nicht. Bitte den PC neu starten oder den Support anrufen."
      break
    fi
    sleep 2
  done
  kiosk_oeffnen http://localhost/
  exit 0
fi
TOKEN_DATEI=/run/studio-setup/token
if [ ! -r "$TOKEN_DATEI" ]; then
  # Dienst läuft nicht (oder Benutzer ist kein Administrator): einmal mit Rückfrage starten.
  pkexec /bin/systemctl start studio-setup.service || true
  i=0
  while [ ! -r "$TOKEN_DATEI" ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
fi
if [ ! -r "$TOKEN_DATEI" ]; then
  meldung "Die Einrichtung lässt sich nur mit einem Administrator-Konto starten."
  exit 1
fi
kiosk_oeffnen "http://127.0.0.1:8099/?t=$(cat "$TOKEN_DATEI")"
