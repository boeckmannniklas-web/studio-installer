#!/bin/sh
# Studio-Icon: nach der Einrichtung die Kasse öffnen, vorher den Einrichtungs-Assistenten.
# Adresse im Standard-Browser öffnen. Nicht über xdg-open: das lädt eine http-Adresse unter
# GNOME per gvfs und öffnet sie womöglich im Texteditor.
oeffnen() {
  BROWSER=$(xdg-settings get default-web-browser 2>/dev/null || true)
  if [ -n "$BROWSER" ] && command -v gtk-launch >/dev/null 2>&1; then
    gtk-launch "$BROWSER" "$1" && return 0
  fi
  if command -v firefox >/dev/null 2>&1; then
    firefox --new-window "$1" && return 0
  fi
  xdg-open "$1"
}

if [ -f /opt/studio/installiert.json ]; then
  oeffnen http://localhost/
  exit 0
fi
TOKEN_DATEI=/run/studio-setup/token
if [ ! -r "$TOKEN_DATEI" ]; then
  # Dienst läuft nicht (oder Benutzer ist kein Administrator): einmal mit Rückfrage starten.
  pkexec /bin/systemctl start studio-setup.service || true
  i=0
  while [ ! -r "$TOKEN_DATEI" ] && [ $i -lt 20 ]; do sleep 0.5; i=$((i + 1)); done
fi
if [ ! -r "$TOKEN_DATEI" ]; then
  notify-send "Studio" "Die Einrichtung lässt sich nur mit einem Administrator-Konto starten." 2>/dev/null \
    || echo "Die Einrichtung lässt sich nur mit einem Administrator-Konto starten." >&2
  exit 1
fi
oeffnen "http://127.0.0.1:8099/?t=$(cat "$TOKEN_DATEI")"
