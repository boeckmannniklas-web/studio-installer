[Unit]
Description=Studio nach der Anmeldung im Kioskmodus öffnen (nur Studio-Image)
# Nur auf dem Studio-Image (/etc/studio-os): wer den Installer per Einzeiler auf einen
# vorhandenen PC holt, bekommt kein Vollbild aufgezwungen. Dort öffnet das Icon.
ConditionPathExists=/etc/studio-os
After=graphical-session.target studio-schreibtisch.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/studio
# Der Starter wartet nach dem Hochfahren bis zu 3 Minuten, bis Studio antwortet.
TimeoutStartSec=5min
# Den Browser startet er als eigene Unit; falls das nicht geht, soll er trotzdem bleiben.
KillMode=process

[Install]
WantedBy=graphical-session.target
